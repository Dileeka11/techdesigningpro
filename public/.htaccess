# TechDesigningPro – Apache config for shared hosting (cPanel / public_html)
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Force HTTPS + www (uncomment once the SSL certificate is active) ---
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.techdesigningpro.com%{REQUEST_URI} [L,R=301]

  # --- Old PHP site URLs -> new pages (keeps Google rankings + old links) ---
  RewriteCond %{QUERY_STRING} (^|&)subid=1(&|$)
  RewriteRule ^services\.php$ /services/project-management/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)subid=2(&|$)
  RewriteRule ^services\.php$ /services/revit/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)subid=3(&|$)
  RewriteRule ^services\.php$ /services/autocad/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)subid=4(&|$)
  RewriteRule ^services\.php$ /services/procurement-management/? [R=301,L]
  RewriteRule ^services\.php$ /services/? [R=301,L]
  RewriteRule ^index\.php$ /? [R=301,L]
  RewriteRule ^profile\.php$ /about-us/? [R=301,L]
  RewriteRule ^gallery\.php$ /gallery/? [R=301,L]
  RewriteRule ^contact-us\.php$ /contact-us/? [R=301,L]

</IfModule>

# --- Compression ---
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml application/xml
</IfModule>

# --- Types ---
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Next.js JS/CSS/fonts have content hashes in their names -> cache forever
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
